# Variáveis do docker-compose.prod.yaml (VPS). Copie para .env e preencha.
# Nunca versione o .env. As senhas de anne_app e anne_migrator são geradas por
# ficha-buffet/db-admin/privilegios/definir-senhas.py (ou \password no psql).

# Postgres — superusuário administrativo (contingência; NÃO é usado pelo backend)
DB_NAME=fichadb
POSTGRES_USER=anne
POSTGRES_PASSWORD=

# Backend — conexão de runtime (privilégio mínimo)
URL_DB=jdbc:postgresql://db:5432/fichadb
DB_USERNAME=anne_app
DB_PASSWORD=

# Backend — conexão do Flyway (migrations; faz SET ROLE anne_owner)
FLYWAY_USER=anne_migrator
FLYWAY_PASSWORD=
# Opcional: FLYWAY_URL (padrão = URL_DB) e FLYWAY_ROLE (padrão = anne_owner)

URL_FRONTEND=https://seu-dominio
COOKIE_SECURE=true
BLOB_READ_WRITE_TOKEN=
