# URL base da API backend.
# Em produção, aponte para o serviço real (ex: https://api.anneservicos.com.br).
# Deixe em branco / aponte para "/api" para usar as Route Handlers internas do Next.js
# como backend de referência (armazenamento em arquivo local — ver lib/server/db.ts).
API_BASE_URL=http://localhost:3000/api

# Chave de API para o backend (nunca prefixe com NEXT_PUBLIC_ — isso a exporia no bundle do cliente).
# Deixe vazia no ambiente de referência local.
API_SECRET_KEY=

# Ambiente
NODE_ENV=development
