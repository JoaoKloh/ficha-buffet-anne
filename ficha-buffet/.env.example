# ficha-buffet/.env — lido pelo Spring (spring.config.import) e pelo docker-compose.yaml.
# Copie para .env. Nunca versione o .env.
# As senhas de anne_app e anne_migrator são geradas por db-admin/privilegios/definir-senhas.py.

# Postgres local — superusuário administrativo (contingência; NÃO é usado pelo backend)
DB_NAME=fichadb
POSTGRES_USER=anne
POSTGRES_PASSWORD=

# Conexão de runtime (privilégio mínimo)
URL_DB=jdbc:postgresql://localhost:5432/fichadb
DB_USERNAME=anne_app
DB_PASSWORD=

# Conexão do Flyway (migrations; faz SET ROLE anne_owner)
FLYWAY_USER=anne_migrator
FLYWAY_PASSWORD=
# Opcional: FLYWAY_URL (padrão = URL_DB) e FLYWAY_ROLE (padrão = anne_owner)

URL_FRONTEND=http://localhost:3000
COOKIE_SECURE=false
RSA_PUBLIC_KEY_PATH=src/main/resources/keys/public.pem
RSA_PRIVATE_KEY_PATH=src/main/resources/keys/private.pem
